  "claims": [
    {
      "id": "c1",
      "statement": "Elsevier requires the name of the model or tool, the version used, and the developer or manufacturer for AI-generated images.",
      "status": "sourced",
      "locator": {
        "section": "opening"
      },
      "kind": "empirical",
      "evidence": [
        "e1"
      ]
    },
    {
      "id": "c2",
      "statement": "The medical journal editors require authors to disclose whether AI-assisted technologies were used and describe how, and refuse to list a chatbot as an author because it cannot be responsible for accuracy, integrity and originality.",
      "status": "sourced",
      "locator": {
        "section": "opening"
      },
      "kind": "empirical",
      "evidence": [
        "e2"
      ]
    },
    {
      "id": "c3",
      "statement": "EU AI Act Article 50 requires synthetic content to be marked as artificially generated or manipulated, and people to be told when they are interacting with an AI system.",
      "status": "sourced",
      "locator": {
        "section": "opening"
      },
      "kind": "empirical",
      "evidence": [
        "e3"
      ]
    },
    {
      "id": "c4",
      "statement": "The deepfake and public-interest-text duties apply from 2 August 2026, and the machine-readable marking duty runs to 2 December 2026 for systems already on the market.",
      "status": "recalled",
      "locator": {
        "section": "opening"
      },
      "kind": "empirical",
      "evidence": [
        "e3"
      ],
      "challenged": "holds-with-boundary"
    },
    {
      "id": "c5",
      "statement": "Sixteen preregistered experiments with 27,491 participants found identical creative writing rated lower when attributed to AI.",
      "status": "sourced",
      "locator": {
        "section": "The tick box is doing damage while it sits there"
      },
      "kind": "empirical",
      "evidence": [
        "e4"
      ]
    },
    {
      "id": "c6",
      "statement": "A separate experiment with 800 participants found an AI-content label had no significant effect on perceived accuracy, message credibility or sharing intention for misinformation.",
      "status": "sourced",
      "locator": {
        "section": "The tick box is doing damage while it sits there"
      },
      "kind": "empirical",
      "evidence": [
        "e5"
      ]
    },
    {
      "id": "c7",
      "statement": "Attaching warnings to a subset of false headlines raised willingness to share the untagged false headlines from 29.8 per cent to 36.2 per cent.",
      "status": "sourced",
      "locator": {
        "section": "The tick box is doing damage while it sits there"
      },
      "kind": "empirical",
      "evidence": [
        "e6"
      ]
    },
    {
      "id": "c8",
      "statement": "Across 26 models, hallucination rates range from 22 per cent to 94 per cent; SWE-bench Verified performance rose from roughly 60 per cent in 2024 to close to 100 per cent in 2025.",
      "status": "sourced",
      "locator": {
        "section": "Is the badge at least a rough guide to quality?"
      },
      "kind": "empirical",
      "evidence": [
        "e7"
      ]
    },
    {
      "id": "c9",
      "statement": "Alsup called training on lawfully acquired books exceedingly transformative fair use, and held that the separately pirated library displaced demand for the authors' books.",
      "status": "sourced",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "empirical",
      "evidence": [
        "e8"
      ]
    },
    {
      "id": "c10",
      "statement": "Final approval of the Bartz settlement was granted on 20 July 2026 and the case is on appeal to the Ninth Circuit.",
      "status": "sourced",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "empirical",
      "evidence": [
        "e9"
      ]
    },
    {
      "id": "c11",
      "statement": "The Third Circuit heard argument in Thomson Reuters v. Ross Intelligence on 11 June 2026 and had not issued a decision as at 30 August 2026.",
      "status": "sourced",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "empirical",
      "evidence": [
        "e10"
      ]
    },
    {
      "id": "c12",
      "statement": "Chhabria ruled for Meta and wrote that the ruling does not stand for the proposition that Meta's use of copyrighted materials to train its language models is lawful.",
      "status": "sourced",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "empirical",
      "evidence": [
        "e11"
      ]
    },
    {
      "id": "c13",
      "statement": "Getty abandoned its primary copyright claims during the UK trial, so the training question was not decided there.",
      "status": "sourced",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "empirical",
      "evidence": [
        "e12"
      ]
    },
    {
      "id": "c14",
      "statement": "On GPQA Diamond, selecting among generated candidates with weak verifiers closed a 37.3-percentage-point gap over majority voting.",
      "status": "sourced",
      "locator": {
        "section": "Is the badge at least a rough guide to quality?"
      },
      "kind": "empirical",
      "evidence": [
        "e13"
      ]
    },
    {
      "id": "c15",
      "statement": "The United States cleared an autonomous diagnostic system in 2018 that makes an assessment without a clinician interpreting each case.",
      "status": "sourced",
      "locator": {
        "section": "Is the badge at least a rough guide to quality?"
      },
      "kind": "empirical",
      "evidence": [
        "e14"
      ]
    },
    {
      "id": "c16",
      "statement": "In the MASAI trial the AI-supported arm had an interval cancer rate of 1.55 per 1,000 against 1.76 for standard double reading.",
      "status": "sourced",
      "locator": {
        "section": "Is the badge at least a rough guide to quality?"
      },
      "kind": "empirical",
      "evidence": [
        "e15"
      ],
      "challenged": "holds-with-boundary"
    },
    {
      "id": "c17",
      "statement": "Disclosure carries two separable signals: a capability signal that decays as systems improve, and a provenance signal that does not.",
      "status": "inferred",
      "locator": {
        "section": "opening"
      },
      "kind": "position"
    },
    {
      "id": "c18",
      "statement": "The acquisition question is answerable only by whoever built and trained the model, so the burden sits upstream of the writer.",
      "status": "inferred",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "position"
    },
    {
      "id": "c19",
      "statement": "Verifier ensembling and AI-first-pass-with-human-adjudication generalise to ordinary knowledge work; formal verification, calibrated abstention and closed loops over a stationary distribution do not.",
      "status": "inferred",
      "locator": {
        "section": "What would make me wrong"
      },
      "kind": "empirical"
    },
    {
      "id": "c20",
      "statement": "Nobody has measured how real knowledge work divides between checkable and open-ended tasks, or published production defect rates for it.",
      "status": "inferred",
      "locator": {
        "section": "What would make me wrong"
      },
      "kind": "empirical"
    },
    {
      "id": "c21",
      "statement": "\"Made in Australia\" requires only that the last substantial transformation happened here, while \"Product of Australia\" requires the main ingredients and almost all processing to be Australian.",
      "status": "sourced",
      "locator": {
        "section": "opening"
      },
      "kind": "empirical",
      "evidence": [
        "e16"
      ]
    },
    {
      "id": "c22",
      "statement": "Of the papers accepted by the first review committee, 50.6 per cent were rejected by a second committee reviewing the same papers.",
      "status": "sourced",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "empirical",
      "evidence": [
        "e17"
      ]
    },
    {
      "id": "c23",
      "statement": "Across every condition tested in the choice-blindness experiments, no more than 26 per cent of the covert swaps were detected.",
      "status": "sourced",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "empirical",
      "evidence": [
        "e18"
      ]
    },
    {
      "id": "c24",
      "statement": "One of the Australian regulators supervising a licensed profession will publish guidance permitting an AI system to produce a regulated work product with no per-item human sign-off, before the end of 2028.",
      "status": "inferred",
      "locator": {
        "section": "Is the badge at least a rough guide to quality?"
      },
      "kind": "empirical",
      "evidence": [
        "e7",
        "e13",
        "e14",
        "e15"
      ],
      "assertion": "predictive",
      "resolves": {
        "by": "2028-12-31",
        "criterion": "A named Australian regulator publishes guidance or a decision permitting an AI-produced work product in a compliance process with no per-item human sign-off. The date is a review date, not an expiry: a later arrival resolves the claim true on the wrong clock, and only a reversal of direction resolves it false."
      },
      "falsifier": "Regulators moving the other way: an existing per-item exemption withdrawn, or the verification advantage failing to transfer out of imaging and code."
    },
    {
      "id": "c25",
      "statement": "The capability and provenance signals overlap in what they name, and separate on who can answer and whether the answer expires.",
      "status": "inferred",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "position",
      "falsifier": "A disclosure that answers both questions, answerable by the same party, whose answer decays at the same rate."
    },
    {
      "id": "c26",
      "statement": "A disclosure designed to minimise liability is designed not to be useful, and organisations already reject that trade in financial, safety and incident reporting.",
      "status": "inferred",
      "locator": {
        "section": "Will our lawyers sign this?"
      },
      "kind": "position",
      "falsifier": "A regulated reporting regime whose minimum-liability form is also its most decision-useful form."
    },
    {
      "id": "c27",
      "statement": "The bar disclosure should meet is that a reader can interrogate it, not that a reader can independently reproduce it.",
      "status": "inferred",
      "locator": {
        "section": "Ask for the ingredients list"
      },
      "kind": "position",
      "falsifier": "A disclosure practice where readers routinely do reproduce the result, making interrogation the weaker standard."
    },
    {
      "id": "c28",
      "statement": "A choice can be read out of prefrontal and parietal activity up to ten seconds before it enters awareness, in a low-stakes button-press task with prediction a little above chance.",
      "status": "sourced",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "empirical",
      "evidence": [
        "e19"
      ],
      "challenged": "holds-with-boundary"
    },
    {
      "id": "c29",
      "statement": "Chain-of-thought explanations systematically misrepresent the true reason for a model's answer; a biasing hint moved answers and dropped accuracy by as much as 36 per cent across thirteen tasks.",
      "status": "sourced",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "empirical",
      "evidence": [
        "e20"
      ]
    },
    {
      "id": "c30",
      "statement": "Claude 3.7 Sonnet acknowledged a hint it had used 25 per cent of the time and DeepSeek R1 39 per cent, and the unfaithful explanations were longer than the faithful ones.",
      "status": "sourced",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "empirical",
      "evidence": [
        "e21"
      ]
    },
    {
      "id": "c31",
      "statement": "The reasoning offered by a person and by a model are the same kind of object, a justification composed after the answer, so neither column of the checkbox can produce an explanation a reader could check.",
      "status": "inferred",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "synthesis",
      "evidence": [
        "e18",
        "e19",
        "e20",
        "e21"
      ],
      "falsifier": "A method that verifies, from outside, that a stated reason was the cause of the decision it describes.",
      "holds_when": [
        {
          "dimension": "account strength",
          "value": "unverifiable",
          "basis": "inferred"
        }
      ],
      "fails_when": [
        {
          "dimension": "account strength",
          "value": "false",
          "basis": "inferred"
        }
      ],
      "unknown_region": "Whether a human's partial introspective access ever recovers the real cause accurately.",
      "replaced_by": {
        "claim": "c33"
      }
    },
    {
      "id": "c32",
      "statement": "Australian obligations are already moving toward requiring more disclosure, not less: APRA's April 2026 statement, the National AI Centre's essential practices, and the Privacy Act's automated-decision policy duty from 10 December 2026.",
      "status": "sourced",
      "locator": {
        "section": "Will our lawyers sign this?"
      },
      "kind": "empirical",
      "evidence": [
        "e3"
      ],
      "challenged": "holds-with-boundary"
    },
    {
      "id": "c33",
      "statement": "In the region where the strong claim fails, a person's after-the-fact account can be an accurate reconstruction of the real cause; what is missing is any way for a reader to tell which accounts those are.",
      "status": "inferred",
      "locator": {
        "section": "But surely a machine decision needs more justification than a human one?"
      },
      "kind": "position",
      "holds_when": [
        {
          "dimension": "account strength",
          "value": "false",
          "basis": "inferred"
        }
      ],
      "falsifier": "A demonstration that after-the-fact accounts are never accurate, or a reliable external test that sorts the accurate ones from the confabulated ones.",
      "evidence": []
    }
